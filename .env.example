# Compte Gmail expéditeur (mot de passe d'application Google, pas le mot de passe du compte)
GOOGLE_USERMAIL="votre-compte@gmail.com"
GOOGLE_PASSWORD="xxxx xxxx xxxx xxxx"

# Adresse qui reçoit les messages du formulaire de contact
GOOGLE_USER_DESTINATION="votre-compte@gmail.com"

# Port du serveur autonome (optionnel, 3001 par défaut ; ignoré sur Vercel)
PORT=3001
